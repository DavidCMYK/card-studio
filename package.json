{
  "name": "card-studio",
  "private": true,
  "version": "0.2.0",
  "description": "Game card layout editor",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.cjs",
    "build:pages": "npm test && node scripts/build-pages.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "deploy:worker": "wrangler deploy",
    "deploy": "npm run build:pages && wrangler deploy",
    "deploy:test": "npm run build:pages && wrangler deploy --config wrangler.test.jsonc",
    "build:mobile": "npm run build:pages && node scripts/build-mobile.cjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
